# FMMS — environment configuration template
# Copy to `.env` and fill in. `.env` is gitignored.

# ── Postgres + TimescaleDB ───────────────────────────────────────
POSTGRES_USER=fmms
POSTGRES_PASSWORD=changeme
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────────────────────────
REDIS_PORT=6379

# ── MQTT broker ──────────────────────────────────────────────────
MQTT_PORT=1883

# ── Kafka (Redpanda in PoC) ──────────────────────────────────────
KAFKA_PORT=9092

# ── Observability ────────────────────────────────────────────────
GRAFANA_PASSWORD=admin

# ── Sensor simulator ─────────────────────────────────────────────
# Phase 0 D-02: PoC scale = 1,000 simulated sensors.
SIM_SENSOR_COUNT=1000
SIM_AREA_COUNT=20
# Phase 0 D-01: 60 s nominal, 5 s critical.
SIM_NOMINAL_INTERVAL_S=60
SIM_CRITICAL_INTERVAL_S=5

# ── JWT keys (auth-service) ──────────────────────────────────────
# Generate with:
#   openssl genpkey -algorithm RSA -out jwt_private.pem -pkeyopt rsa_keygen_bits:2048
#   openssl rsa -in jwt_private.pem -pubout -out jwt_public.pem
JWT_PRIVATE_KEY_PATH=./secrets/jwt_private.pem
JWT_PUBLIC_KEY_PATH=./secrets/jwt_public.pem
JWT_ACCESS_TTL_S=3600
JWT_REFRESH_TTL_S=86400

# ── Rule engine thresholds ───────────────────────────────────────
# These are PoC placeholders (Phase 0 D-04). Real thresholds live
# in the geo-service config table per area.
THRESHOLD_WATER_LEVEL_CRITICAL_M=3.0
THRESHOLD_RAINFALL_CRITICAL_MM_H=30
THRESHOLD_SOIL_SAT_CRITICAL_PCT=90
THRESHOLD_WIND_CRITICAL_M_S=25

# ── Energy measurement ───────────────────────────────────────────
# CodeCarbon project name (NFR-07).
CODECARBON_PROJECT=fmms-poc
CODECARBON_OUTPUT_DIR=./tools/energy/runs

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
